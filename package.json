{
  "name": "@junerver/dsh-workspace",
  "version": "1.2.0",
  "description": "DSH plugin: move a conversation into a directory workspace from the sidebar (drag or menu).",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "workspace",
    "session",
    "sidebar",
    "drag-and-drop",
    "工作区",
    "会话",
    "拖拽"
  ],
  "author": "junerver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junerver/dsh-workspace.git"
  },
  "homepage": "https://github.com/junerver/dsh-workspace#readme",
  "bugs": {
    "url": "https://github.com/junerver/dsh-workspace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  }
}
