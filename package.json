{
  "name": "@local/workspace-move",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Move a conversation into a directory workspace from the sidebar (drag or menu).",
  "keywords": ["dsh", "dsh-plugin", "workspace", "session"],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-commands"]
    }
  }
}
